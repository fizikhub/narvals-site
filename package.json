{
  "name": "narvals-labs-homepage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "SITE_MODE=development npm run seo:generate && vite --host 0.0.0.0",
    "seo:generate": "node scripts/generate-site.mjs",
    "build": "SITE_MODE=production npm run seo:generate && npm run html:check && vite build && node scripts/copy-public-assets.mjs && SITE_MODE=production node scripts/check-seo.mjs --dist",
    "build:production": "REQUIRE_SITE_URL=1 npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "seo:check": "SITE_MODE=development node scripts/check-seo.mjs",
    "seo:check-live": "SITE_MODE=production node scripts/check-live-seo.mjs",
    "indexnow:submit": "SITE_MODE=production node scripts/submit-indexnow.mjs",
    "html:check": "html-validate 'index.html' 'hizmetler/index.html' 'hizmetler/*/index.html' 'hakkimizda/index.html' 'iletisim/index.html' 'blog/index.html' 'blog/*/index.html' 'editoryal-ilkeler/index.html' '404.html'"
  },
  "dependencies": {
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/anybody": "^5.2.8",
    "@fontsource-variable/onest": "^5.2.8",
    "@fontsource/azeret-mono": "^5.2.6",
    "gsap": "^3.13.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "html-validate": "^11.6.2",
    "vite": "^7.0.6"
  }
}
